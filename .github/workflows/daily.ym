name: 매일 아침 뉴스 업데이트

on:
  schedule:
    # 매일 한국시간 오전 6시 (UTC 21:00). GitHub 사정으로 수십 분 늦을 수 있어요.
    - cron: "0 21 * * *"
  workflow_dispatch: {}   # Actions 탭에서 수동 실행 버튼

permissions:
  contents: write

concurrency:
  group: daily-news
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - run: pip install -r requirements.txt

      - name: 뉴스 수집·요약
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: python -m scraper.run

      - name: 결과 커밋
        run: |
          git config user.name "easynews-bot"
          git config user.email "easynews-bot@users.noreply.github.com"
          git add docs/data
          git diff --cached --quiet || git commit -m "뉴스 업데이트 $(TZ=Asia/Seoul date +%F)"
          git push

      # Pages가 새 데이터를 반영할 시간을 잠깐 준 뒤 알림 (설정한 것만 전송)
      - name: 아침 알림 보내기
        continue-on-error: true
        env:
          SITE_URL: ${{ vars.SITE_URL }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          SMTP_HOST: ${{ secrets.SMTP_HOST }}
          SMTP_PORT: ${{ secrets.SMTP_PORT }}
          SMTP_USER: ${{ secrets.SMTP_USER }}
          SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
          MAIL_TO: ${{ secrets.MAIL_TO }}
        run: |
          sleep 60
          python -m scraper.notify
